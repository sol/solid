with-compiler: ghc-9.10.3

packages:
  .
  arcade
  solid-pp
  haskell-base
  solid-doctest
  vendor/ghc-bin

program-options
  ghc-options: -Werror

package solid-doctest
  executable-dynamic: true

package ghc-bin
  executable-dynamic: true

tests: True

source-repository-package
  type: git
  location: https://github.com/sol/solid-stack
  tag: v3.3.1-ghc-9.10.3

import: cabal.project.constraints
